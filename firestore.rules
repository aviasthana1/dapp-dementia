rules_version = '2';
// DEMO ONLY — allows unauthenticated read/write (web app + ESP32 REST API).
// ESP32 uses ?key=API_KEY with no Firebase Auth (request.auth is null).
// Publish: Firebase Console → Firestore → Rules → Paste → Publish
// Lock down before production (e.g. require auth or App Check).

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
